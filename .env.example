# Obrigatorio: provedor e modelo.
# Provedores: ollama | gemini | openai | groq
# Ollama roda localmente sem chave; veja docs/ollama.md.
LLM_PROVIDER=
LLM_MODEL=
LLM_TEMPERATURE=0

# Necessario apenas quando LLM_PROVIDER=ollama.
# OLLAMA_BASE_URL=http://localhost:11434

# Configure apenas a chave do provedor escolhido.
# OPENAI_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=

DB_PATH=data/anexo_desafio_1.db
SQL_MAX_REPAIR_ATTEMPTS=3
SQL_ROW_LIMIT=1000
SQL_TIMEOUT_SECONDS=10

# Requisicoes por segundo ao provedor (0 desativa). Na camada gratuita do
# Gemini, 0.2 mantem o fluxo abaixo de 15 requisicoes por minuto.
LLM_REQUESTS_PER_SECOND=0
